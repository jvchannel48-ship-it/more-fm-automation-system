# Supabase PostgreSQL connection URI (not the Supabase REST URL or API key).
# Copy the Database > Connection string URI from Supabase and set this in the host's secret manager.
POSTGRES_URL=postgresql://postgres:<DATABASE_PASSWORD>@db.<PROJECT_REF>.supabase.co:5432/postgres?sslmode=require

# Admin login/session configuration. Use a long random value in production.
ADMIN_PASSWORD=
ADMIN_SECRET=

# Required for the private Supabase Storage media endpoints.
SUPABASE_URL=https://<PROJECT_REF>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Required by the protected once-per-minute MOR sync cron endpoint.
CRON_SECRET=
